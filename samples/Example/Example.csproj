<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="System.Interactive.Async" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Josupeit.Mail.Milter\Josupeit.Mail.Milter.csproj" />
    
    <!--
      What a consumer gets from the package as an analyzer asset. It has to be asked for by hand here
      because analyzers do not flow across a ProjectReference the way they do across a PackageReference.
      No assembly reference: the marker attributes travel inside Josupeit.Mail.Milter.
    -->
    <ProjectReference Include="..\..\src\Josupeit.Mail.Milter.Generator\Josupeit.Mail.Milter.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
