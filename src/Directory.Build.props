<Project>

  <!--
    MSBuild only picks up the *nearest* Directory.Build.props, so the repository-wide one has to be
    imported by hand. Without this line the projects under src lose EnforceCodeStyleInBuild and the
    style rules go back to only colouring the editor.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Manuel Josupeit-Walter</Authors>
    <Company>Manuel Josupeit-Walter, Freelancing Developer</Company>
    <Product>Manuel Josupeit-Walter, Mail Filtering</Product>
    <Copyright>© 2026 Manuel Josupeit-Walter</Copyright>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/DerPeit/Josupeit.Mail.Milter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DerPeit/Josupeit.Mail.Milter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile Condition="Exists('README.md')">README.md</PackageReadmeFile>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageVersionTagPrefix />
    <PackageReleaseNotesGitPath>. ../Directory.Build.props ../Directory.Build.targets</PackageReleaseNotesGitPath>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The doc file is what makes a missing or incomplete doc comment visible at all: it switches on
      CS1591 (undocumented public member), CS1573 (a parameter without its own param tag) and their
      siblings. Neither is suppressed - see CONTRIBUTING.md for the rule they enforce.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Ship the sources with the package so a consumer can step into this code instead of guessing at
      it. SourceLink itself needs no PackageReference: since .NET 8 the SDK contributes the GitHub
      provider on its own for a repository whose origin is github.com. Moving to Codeberg means adding
      Microsoft.SourceLink.Gitea and a SourceLinkGiteaHost item, because the SDK ships no Gitea provider.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSource>true</IncludeSource>
    <GenerateSBOM Condition="'$(IsPackable)' == 'true'">true</GenerateSBOM>
    <NoWarn>$(NoWarn);NETSDK1138;NETSDK1215</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE.md" Pack="true" PackagePath="\" Link="LICENSE.md" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Bounded ranges as everywhere else, but note the lower bound has to be a version that exists: NuGet
      resolves a range to its *lowest* satisfying version, so "[3,4)" would pull Nerdbank.GitVersioning
      3.0.24, whose LibGit2Sharp cannot even load on a current runtime.
    -->
    <PackageReference Include="Microsoft.Sbom.Targets" Version="[4.0.2,5)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Nerdbank.GitVersioning" Version="[3.9.50,4)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
