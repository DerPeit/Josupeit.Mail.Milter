<Project>

  <!--
    MSBuild only picks up the *nearest* Directory.Build.props, so the repository-wide one has to be
    imported by hand. Without this line the projects under src lose EnforceCodeStyleInBuild and the
    style rules go back to only colouring the editor.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsTrimmable>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The SDK runs the CA rules by default, but only the subset it calls the default set. This turns
      every rule on and pins the level, so a new SDK does not quietly change which rules apply.

      Here rather than in the repository-wide props on purpose: the rules police a shipped surface, and
      most of what they say is meaningless for the projects that ship nothing. Underscored test names,
      an un-awaited ConfigureAwait in a test, a sample type the generator instantiates by reflection -
      all of it would be noise, and hundreds of lines of it, drowning the handful of findings that
      actually concern a consumer.
    -->
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Manuel Josupeit-Walter</Authors>
    <Company>Manuel Josupeit-Walter, Freelancing Developer</Company>
    <Product>Manuel Josupeit-Walter, Mail Filtering</Product>
    <Copyright>© 2026 Manuel Josupeit-Walter</Copyright>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://codeberg.org/DerPeit/Josupeit.Mail.Milter</PackageProjectUrl>
    <RepositoryUrl>https://codeberg.org/DerPeit/Josupeit.Mail.Milter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile Condition="Exists('README.md')">README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageVersionTagPrefix />
    <!--
      Which paths the release notes in Directory.Build.targets watch. The list is everything whose
      change alters what a consumer receives and nothing else - the project, the two files that shape
      the package, the generator whose assembly ships under analyzers/, the repository props that
      supply PolySharp, and the packed icon. Tests, samples and the workflow are absent on purpose.

      They are pathspecs relative to the project directory, so "." is src\Josupeit.Mail.Milter and not
      src - which is why the sibling generator has to be named even though it shares this props file.
    -->
    <PackageReleaseNotesGitPath>. ../Directory.Build.props ../Directory.Build.targets ../Josupeit.Mail.Milter.Generator ../../Directory.Build.props ../../assets/icon.png</PackageReleaseNotesGitPath>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The doc file is what makes a missing or incomplete doc comment visible at all: it switches on
      CS1591 (undocumented public member), CS1573 (a parameter without its own param tag) and their
      siblings. Neither is suppressed - see CONTRIBUTING.md for the rule they enforce.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Ship the sources with the package so a consumer can step into this code instead of guessing at
      it. SourceLink is the part that has to be said out loud: the SDK contributes a provider on its own
      for each host it knows, and Gitea is not one of them - so Codeberg needs Microsoft.SourceLink.Gitea
      and the SourceLinkGiteaHost item below. Forget either and nothing fails; the package just quietly
      loses source stepping.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSource>true</IncludeSource>
    <NoWarn>$(NoWarn);NETSDK1138;NETSDK1215</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Names the host so SourceLink knows codeberg.org is a Gitea instance and not some unknown domain. -->
    <SourceLinkGiteaHost Include="codeberg.org" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />

    <!--
      The documentation written for coding agents rather than people, in llmstxt.org form. Packed beside
      the README so the copy in a consumer's package cache describes exactly the version they installed;
      the copy on main describes the latest release. scripts/check-llms-docs.sh keeps it honest.
    -->
    <None Include="llms.txt" Pack="true" PackagePath="\" Condition="Exists('llms.txt')" />
    <None Include="llms-full.txt" Pack="true" PackagePath="\" Condition="Exists('llms-full.txt')" />
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE.md" Pack="true" PackagePath="\" Link="LICENSE.md" Visible="false" />

    <!-- 256x256, not the 1254x1254 master beside it: NuGet caps a package icon at 1 MB. -->
    <None Include="$(MSBuildThisFileDirectory)..\assets\icon.png" Pack="true" PackagePath="\" Link="icon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The ban list itself, shared by every project under src. AdditionalFiles paths are relative to
      the *project*, so the one file has to be named from this directory rather than from theirs.
    -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Turns the conventions this code already keeps into something a build can fail on. The list is in
      BannedSymbols.txt beside this file, and says there what each entry is for.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!--
      Bounded ranges as everywhere else, but note the lower bound has to be a version that exists: NuGet
      resolves a range to its *lowest* satisfying version, so "[3,4)" would pull Nerdbank.GitVersioning
      3.0.24, whose LibGit2Sharp cannot even load on a current runtime.
    -->
    <PackageReference Include="Microsoft.Sbom.Targets" Version="[4.0.2,5)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.SourceLink.Gitea" Version="[10.0.400,11)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Nerdbank.GitVersioning" Version="[3.9.50,4)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!--
      Every category is on, and .editorconfig switches off the eleven ids someone else already owns:
      the this. prefix, the field and constant naming, the brace family, and the documentation rules
      that CS1591 and CONTRIBUTING.md decide between them. What is left is what nothing else here
      checks - where a member sits in its type, and whether a file ends the way .editorconfig says.
    -->
    <PackageReference Include="StyleCop.Analyzers" Version="[1.2.0-beta.556,2)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
