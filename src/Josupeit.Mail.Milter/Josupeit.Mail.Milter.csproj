<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>An implementation of the Milter protocol (wire version 2), the mail filter protocol spoken by Postfix and Sendmail. Write the filter in C#: implement the callbacks for the SMTP events you care about and the library handles the framing, the option negotiation and the protocol state machine the MTA expects.</Description>
    <PackageTags>milter postfix sendmail smtp mail-filter mta email antispam</PackageTags>
    <PackageVersionTagPrefix>v</PackageVersionTagPrefix>
    <NoWarn>$(NoWarn),CS9107</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Josupeit.Mail.Milter.IntegrationTests" />
    <InternalsVisibleTo Include="Josupeit.Mail.Milter.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ConfigureAwaitChecker.Analyzer" Version="5.0.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Nito.AsyncEx.Coordination" Version="[5,6)" />
    <PackageReference Include="System.Interactive.Async" Version="[6.0.1,7)" />
    <PackageReference Include="System.IO.Pipelines" Version="[8,9)" />
    <PackageReference Include="System.Linq.Async" Version="[6.0.1,7)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Analyzer only, and no assembly reference at all: nothing of the compiler reaches this assembly's
      output or its deps.json. The marker attributes the library applies to IMilterContext and the action
      records come from the linked sources below rather than from the generator's assembly.
    -->
    <ProjectReference Include="..\Josupeit.Mail.Milter.Generator\Josupeit.Mail.Milter.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The declaration half of each marker attribute, compiled into this assembly rather than referenced
      from the generator's. Each has a partial in the generator project carrying the Roslyn side, which is
      the half that must not come along - so these files name nothing outside System, and the generator
      matches them by full type name rather than by symbol.

      They are internal and [Embedded], so a consumer never sees them: an embedded type is not imported by
      a referencing compilation at all, which also stops this copy and the generator's own from ever being
      ambiguous in a project that happens to reference both.
    -->
    <Compile Include="..\Josupeit.Mail.Milter.Generator\EmbeddedAttribute.cs" Link="Properties\EmbeddedAttribute.cs" />
    <Compile Include="..\Josupeit.Mail.Milter.Generator\Markers\ActionRequirementsMarkerAttribute.cs" Link="Properties\ActionRequirementsMarkerAttribute.cs" />
    <Compile Include="..\Josupeit.Mail.Milter.Generator\Markers\MilterActionMarkerAttribute.cs" Link="Properties\MilterActionMarkerAttribute.cs" />
    <Compile Include="..\Josupeit.Mail.Milter.Generator\Markers\MilterCallbackMarkerAttribute.cs" Link="Properties\MilterCallbackMarkerAttribute.cs" />
    <Compile Include="..\Josupeit.Mail.Milter.Generator\Markers\MilterContextMarkerAttribute.cs" Link="Properties\MilterContextMarkerAttribute.cs" />
    <Compile Include="..\Josupeit.Mail.Milter.Generator\Markers\ProtocolRequirementsMarkerAttribute.cs" Link="Properties\ProtocolRequirementsMarkerAttribute.cs" />
  </ItemGroup>

  <!--
    The generator is not a package, so a dependency on it would be a dependency on something that will
    never exist on nuget.org - hence PrivateAssets above. It still has to travel inside this one, under
    the path the compiler looks in, or the generation simply never runs for a consumer.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeGeneratorAsAnalyzerInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="IncludeGeneratorAsAnalyzerInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(Analyzer)" Condition="'%(Filename)' == 'Josupeit.Mail.Milter.Generator'">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
